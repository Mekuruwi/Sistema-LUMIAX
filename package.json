{
  "name": "sistema-lumiax",
  "version": "0.1.0",
  "description": "Sistema de Gestão de Demanda Mensal de Clientes",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run-tests.js",
    "build": "tsc && vite build",
    "start": "npm run build && electron .",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "electron",
    "react",
    "sqlite",
    "lumiax"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "electron-log": "^5.4.4",
    "knex": "^3.3.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.9",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.6.1",
    "electron": "^29.1.0",
    "electron-builder": "^26.15.3",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.2",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.4",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.sistemalumiax.app",
    "productName": "Sistema Lumiax",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "uninstallDisplayName": "Sistema Lumiax"
    }
  }
}
